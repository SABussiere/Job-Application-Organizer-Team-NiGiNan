# Copy to .env.local and fill in from Firebase console:
#   Project settings > General > Your apps > SDK setup and configuration
#
# These values are PUBLIC. They identify your Firebase project and ship to the
# browser in any case. What protects each user's data is firestore.rules,
# checked on every read and write, not keeping this config hidden.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# From Google Cloud Console > APIs & Services > Credentials
# (create an OAuth Client ID of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match a URI you registered on that OAuth Client
# (Authorized redirect URIs). For local dev:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Server-only GroqCloud key used by the tailored resume generator.
GROQ_API_KEY=
# Optional; defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile

# Only needed once you build lib/classify.js with LLM-based extraction.
# ANTHROPIC_API_KEY=
